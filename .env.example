VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_SLOT_HOME=1234567890
VITE_ADSENSE_SLOT_RESULT=0987654321

# Turnstile (前端站点密钥)
VITE_TURNSTILE_SITE_KEY=

# Turnstile (服务端校验密钥，供 Pages Functions / 本地 wrangler 使用)
TURNSTILE_SECRET=

# cron-worker 手动触发 /trigger 的 Bearer 密钥（可选；配置后需要鉴权）
CRON_TRIGGER_SECRET=

# AI 解读预热口子鉴权（高熵随机串；fresh/provider 高权限仅对携带
# Authorization: Bearer <token> 的预热请求开放）
# 生成示例：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ACGTI_PREWARM_TOKEN=

# AI 解读每日真实生成全站上限（默认 1000；仅统计未鉴权请求，预热豁免）
ACGTI_INSIGHT_DAILY_LIMIT=
