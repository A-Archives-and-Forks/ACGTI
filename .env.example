VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_SLOT_HOME=1234567890
VITE_ADSENSE_SLOT_RESULT=0987654321

# Turnstile (前端站点密钥)
VITE_TURNSTILE_SITE_KEY=

# Turnstile (服务端校验密钥，供 Pages Functions / 本地 wrangler 使用)
TURNSTILE_SECRET=

# cron-worker 手动触发 /trigger 的 Bearer 密钥（可选；配置后需要鉴权）
CRON_TRIGGER_SECRET=

# ── AI 结果解读（/api/insight）的模型通道 ──
# 所有通道均为可选：不配置（或配置不齐）则该通道不启用，自动走下一级回退
# （网关 > Workers AI binding > REST），全部不可用时接口返回 no-binding 降级，
# 前端隐藏解读卡片，不影响其他功能。
# 本地联调写入 .dev.vars；线上配置在 Cloudflare Pages 环境变量。

# OpenAI 兼容网关 · 主通道（中文质量最佳）
# AIGW_API_KEY / AIGW_BASE_URL / AIGW_MODEL 三项必须同时配置才启用，
# 缺任一项即视为该通道未配置。代码不设任何默认端点或默认模型，
# 网关地址必须在此显式给出（示例值：https://your-openai-compatible-gateway.example/v1）
AIGW_API_KEY=
AIGW_BASE_URL=
AIGW_MODEL=

# OpenAI 兼容网关 · 第二通道（与主通道相互独立的并发额度）
# 仅供预热脚本双通道分流：仅携带 ACGTI_PREWARM_TOKEN 的预热请求可通过
# 请求体 provider: "aigw2" 指定该通道，线上常规请求永远走主通道。
# 同样三项齐备才启用；两通道模型同名时缓存互通。
AIGW2_API_KEY=
AIGW2_BASE_URL=
AIGW2_MODEL=

# Cloudflare Workers AI REST 直连（本地联调回退通道）
# 一般无需手填：npm run dev:pages 会复用 wrangler 本地 OAuth 登录态自动注入
ACGTI_AI_TOKEN=
ACGTI_AI_ACCOUNT_ID=

# insight 分钟限流覆盖（默认 10 次/分/IP；仅本地预热/联调时放宽，线上保持默认）
ACGTI_INSIGHT_RATE_LIMIT=

# AI 解读预热口子鉴权（高熵随机串；fresh/provider 高权限仅对携带
# Authorization: Bearer <token> 的预热请求开放，且豁免每日熔断）
# 生成示例：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ACGTI_PREWARM_TOKEN=

# AI 解读每日真实生成全站上限（默认 1000；仅统计未鉴权请求，预热豁免）
ACGTI_INSIGHT_DAILY_LIMIT=
